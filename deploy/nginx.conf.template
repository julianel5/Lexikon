server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;

    # The first public URL (Railway's own domain) sends visitors to the custom domain
    if ($host = lexikon.up.railway.app) {
        return 301 https://lexikon.moe$request_uri;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # nginx's mime.types does not know .webmanifest, so it would be sent as application/octet-stream
    location = /manifest.webmanifest {
        default_type application/manifest+json;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
